# pkgdown site (built by GitHub Actions, not committed)
docs/

.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store
# Claude Code. settings.json, commands/ and agents/ are committed shared house
# rules -- see .claude/README.md. Everything else under .claude/ is ignored by
# default, so anything future tooling writes there is not committed by accident.
# .Rbuildignore keeps the whole directory out of the package tarball.
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/agents/
!.claude/README.md
.mcp.json
inst/doc
/doc/
/Meta/
Rplots.pdf

# Compiled artifacts (anywhere in the tree)
*.o
# A TMB compile in progress leaves these, and `*.o` does not match them,
# so `git add -A` during a build would stage one.
*.o.tmp
*.so
*.dll
src/symbols.rds

# Coverage instrumentation (generated by covr / gcov)
*.gcda
*.gcno

# MS Office lock / temp files
~$*

# R CMD check artifacts
*.Rcheck/
..Rcheck/
Rceattle_*.tar.gz

# Test artifacts
# testthat rewrites these on every failing run; they are a snapshot of the last
# failure, not a fixture. (_snaps/ is deliberately NOT here -- those are the
# tracked expected values for snapshot tests.)
tests/testthat/testthat-problems.rds
tests/testthat/_problems/
tests/comparison/WHAM_growth_comparison/wham_model.RDS
tests/comparison/WHAM_growth_comparison/wham_osa.RDS
tests/comparison/WHAM_growth_comparison/rce_osa.RDS

# Scratch OSA comparison plot exports (saved to the working dir when running
# the comparison scripts interactively)
/Len_comp_OSA.png
/wham_osa_plot.png

# Development scratch (plans, handoffs, working notes, golden-reference scratch,
# benchmark harnesses) — kept local, never committed. Verification harnesses that
# the workflow requires live in tools/verify/ instead, so a fresh clone can run them.
/dev/

# Scratchpad / working-tool artifacts (created by dev tooling, not part of the package)
scratchpad_loaded.flag
scratchpad/

# FIMS comparison-run artifact
fims.log

# devtools::build_vignettes() artifacts: knitr figures, and the workbooks the
# data-input vignettes write to demonstrate write_data() / write_template().
/figure/
vignettes/BS2017SS.xlsx
vignettes/my_data_template.xlsx
